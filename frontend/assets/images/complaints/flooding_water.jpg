<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <defs>
    <linearGradient id="g_flooding_water.jpg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#082f49" />
      <stop offset="100%" stop-color="#0f172a" />
    </linearGradient>
    <pattern id="grid" width="30" height="30" patternUnits="userSpaceOnUse">
      <path d="M 30 0 L 0 0 0 30" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="1" />
    </pattern>
  </defs>
  <rect width="600" height="400" fill="url(#g_flooding_water.jpg)" />
  <rect width="600" height="400" fill="url(#grid)" />
  
  <rect x="30" y="30" width="540" height="340" rx="12" fill="none" stroke="#0284c7" stroke-width="2" stroke-opacity="0.4" />
  
  <circle cx="300" cy="160" r="60" fill="#0284c7" fill-opacity="0.15" />
  <circle cx="300" cy="160" r="45" fill="#0284c7" fill-opacity="0.3" />
  <text x="300" y="180" font-size="48" text-anchor="middle">🌊</text>
  
  <text x="300" y="270" font-family="'Segoe UI', Roboto, sans-serif" font-size="20" font-weight="800" fill="#f8fafc" text-anchor="middle" letter-spacing="1">STORMWATER INUNDATION</text>
  <text x="300" y="305" font-family="'Segoe UI', Roboto, sans-serif" font-size="14" font-weight="500" fill="#94a3b8" text-anchor="middle">Knee-deep waterlogging choking transit road</text>
  
  <rect x="220" y="330" width="160" height="24" rx="12" fill="#0284c7" />
  <text x="300" y="346" font-family="'Segoe UI', Roboto, sans-serif" font-size="10" font-weight="700" fill="#ffffff" text-anchor="middle" letter-spacing="1">CIVIC PHOTO RECORD</text>
</svg>